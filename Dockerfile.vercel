FROM vcr.vercel.com/vercel/python:3.11

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

# Install Python dependencies via pip (use the venv provided by the base image)
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application sources
COPY . ./

# Use the port Vercel provides at runtime
ENV PORT 8000
EXPOSE 8000

# Run uvicorn binding to $PORT; Vercel sets PORT automatically
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --log-level info"]
